<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: "My Book Notes - Your Library" })  %> 
<body>
    <header id="home">
        <div id="icon-title">
            <svg id="icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 1C6.75958 1 7.51225 1.3344 8.08496 1.9707C8.66079 2.61051 8.99997 3.49883 9 4.44434H11C11 3.49883 11.3392 2.61051 11.915 1.9707C12.4519 1.37425 13.1468 1.04304 13.8574 1.00391L14 1H18.9668C18.9802 1.01769 19 1.05563 19 1.11133V15.5557C19 15.6115 18.9802 15.6494 18.9668 15.667H13C11.9033 15.667 10.8757 16.1516 10.1357 16.9736C10.0893 17.0252 10.0437 17.0782 10 17.1318C9.95627 17.0782 9.91069 17.0252 9.86426 16.9736C9.12425 16.1516 8.09673 15.667 7 15.667H1.0332C1.01981 15.6494 1.00002 15.6115 1 15.5557V1.11133L1.0127 1.03516C1.0187 1.01917 1.0272 1.00794 1.0332 1H6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <p id="title">My Book Notes</p>
        </div>
        <a href="/books/new" class="btn btn-sm btn-primary">
            <span>
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.08333 0V8.16667M0 4.08333H8.16667" stroke="currentColor" stroke-width="2"/>
                </svg>    
            </span>
            Add
        </a>
    </header>

    <main>
        <%- include('partials/flash') %> 
        <% if (books.length === 0) { %>
         <h1>Your shelf is empty.</h1>
         <p>Add a book and start taking notes.</p>
         <a href="/books/new" class="btn btn-sm btn-primary">
            <span>
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.08333 0V8.16667M0 4.08333H8.16667" stroke="#F6F3EE" stroke-width="2"/>
                </svg>    
            </span>
            Add your first book
        </a>
        <% } else { %>
            <h1>All Library Notes</h1>
            <p>Manage your books ratings, and key summary takeaways.</p>
            <button type="button" id="sort-btn">
                <span>
                    <svg width="18" height="17" viewBox="0 0 18 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.11111 4.9032L4.55556 1.4032L1 4.9032M4.55556 1.4032V15.4032M8.11111 8.4032H11.6667M8.11111 11.9032H14.3333M8.11111 15.4032H17" stroke="#660C00" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                </span>
                Sort by
            </button>
            <form method="GET" action="/" onchange="this.submit()">
                <div id="sort-dropdown">
                    <div id="date-sort">
                        <input type="radio" name="sort" value="date_desc" id="date_desc" <%= currentSort === "date_desc" ? "checked" : "" %>>
                        <label for="date_desc">Newest first</label>
                        <input type="radio" name="sort" value="date_asc" id="date_asc" <%= currentSort === "date_asc" ? "checked" : "" %>>
                        <label for="date_asc">Oldest first</label>
                    </div>
                    <div id="rating-sort">
                        <input type="radio" name="sort" value="rating_desc" id="rating_desc" <%= currentSort === "rating_desc" ? "checked" : "" %>>
                        <label for="rating_desc">Highest rated</label>
                        <input type="radio" name="sort" value="rating_asc" id="rating_asc" <%= currentSort === "rating_asc" ? "checked" : "" %>>
                        <label for="rating_asc">Lowest rated</label>
                    </div>
                </div>
            </form>
            <div class="library">
                <% books.forEach(book => { %>
                 <a href="/books/<%= book.id %>" class="library-card">
                    <% if (book.hasCover) { %>
                        <img class="library-card-cover" src="https://covers.openlibrary.org/b/isbn/<%= book.isbn %>-M.jpg" alt="<%= book.title %> cover">
                    <% } else { %>
                        <img class="library-card-cover" src="/images/placeholder-img.jpg" width="100" alt="">
                        <p>Cover not found</p>
                    <% } %> 
                    <div>
                        <div class="book-title-author">
                            <p><%= book.title %></p>
                            <p><%= book.author %></p>
                        </div>
                        <div class="rating" role="img" aria-label="Rated <%= book.rating %> out of 5">
                            <% for( let i = 1; i <= 5; i++ ) { %>
                                <%- include('partials/star', { filled: i <= book.rating })  %> 
                            <% } %>
                        </div>

                        <p class="library-card-notes"><%= book.notes %></p>
                        <p class="library-card-date-read"><span>Date read </span><%= formatDate(book.date_read) %></p>
                    </div>
                </a>
                <% }) %>
            </div>
        <% } %> 
    </main>
</body>
</html> 