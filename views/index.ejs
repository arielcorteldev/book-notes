<!DOCTYPE html>
<html lang="en">
<% include('partials/head', { title: "My Book Notes - Your Library" })  %> 
<body>
    <header>
        <div id="icon-title">
            <svg id="icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 1C6.75958 1 7.51225 1.3344 8.08496 1.9707C8.66079 2.61051 8.99997 3.49883 9 4.44434H11C11 3.49883 11.3392 2.61051 11.915 1.9707C12.4519 1.37425 13.1468 1.04304 13.8574 1.00391L14 1H18.9668C18.9802 1.01769 19 1.05563 19 1.11133V15.5557C19 15.6115 18.9802 15.6494 18.9668 15.667H13C11.9033 15.667 10.8757 16.1516 10.1357 16.9736C10.0893 17.0252 10.0437 17.0782 10 17.1318C9.95627 17.0782 9.91069 17.0252 9.86426 16.9736C9.12425 16.1516 8.09673 15.667 7 15.667H1.0332C1.01981 15.6494 1.00002 15.6115 1 15.5557V1.11133L1.0127 1.03516C1.0187 1.01917 1.0272 1.00794 1.0332 1H6Z" stroke="#01063B" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <p id="title">My Book Notes</p>
        </div>
        <button class="btn btn-sm btn-primary">
            <span>
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.08333 0V8.16667M0 4.08333H8.16667" stroke="#F6F3EE" stroke-width="2"/>
                </svg>    
            </span>
            Add
        </button>
    </header>

    <main>
        <% if (!books) { %>
         <h1>Your shelf is empty.</h1>
         <p>Add a book and start taking notes.</p>
         <button class="btn btn-sm btn-primary">
            <span>
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.08333 0V8.16667M0 4.08333H8.16667" stroke="#F6F3EE" stroke-width="2"/>
                </svg>    
            </span>
            Add your first book
        </button>
        <% } else { %>
            <h1>All Library Notes</h1>
            <p>Manage your books ratings, and key summary takeaways.</p>
            <div class="library">
                
            </div>
        <% } %> 
    </main>
</body>
</html> 