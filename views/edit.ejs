<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: "Edit book" })  %> 
<body>
    <header id="add-book">
        <div class="page-title">
            <a href="/" id="back-link">‹ Back to Library</a><span> | </span>
            <p>Edit Book</p>
        </div>
    </header>

    <main>
        <%- include('partials/flash') %>
        <form id="book-form" method="POST" action="/books" novalidate>
            <h1>Book Details</h1>
            <hr>

            <div class="form-field">
                <label for="title">Book Title</label>
                <input type="text" name="title" id="title" value="<%= book.title %>" maxlength="200" required aria-describedby="<%= errors.title ? 'title-error' : '' %>" aria-invalid="<%= errors.title ? 'true' : 'false' %>">
                <% if (errors.title) { %>
                    <p class="field-error" id="title-error">
                        <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                        </svg>  
                        <%= errors.title %>
                    </p>
                <% } %>
            </div>
            
            <div class="form-field">
                <label for="author">Author</label>
                <input type="text" name="author" id="author" value="<%= book.author %>" maxlength="200" required aria-describedby="<%= errors.author ? 'author-error' : '' %>" aria-invalid="<%= errors.author ? 'true' : 'false' %>">
                <% if (errors.author) { %>
                    <p class="field-error" id="author-error">
                        <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                        </svg>  
                        <%= errors.author %>
                    </p>
                <% } %>
            </div>
            
            <div class="form-field">
                <label for="date-read">Date read</label>
                <input type="date" name="date_read" id="date-read" value="<%= book.date_read %>" required aria-describedby="<%= errors.date_read ? 'date-read-error' : '' %>" aria-invalid="<%= errors.date_read ? 'true' : 'false' %>">
                <% if (errors.date_read) { %>
                    <p class="field-error" id="date-read-error">
                        <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                        </svg>  
                        <%= errors.date_read %>
                    </p>
                <% } %>
            </div>
            
            <div class="form-field">
                <label for="isbn">ISBN <span>(Optional)</span></label>
                <input type="text" name="isbn" id="isbn" maxlength="17" value="<%= book.isbn %>" aria-describedby="<%= errors.isbn ? 'isbn-error' : '' %>" aria-invalid="<%= errors.isbn ? 'true' : 'false' %>" placeholder="9780743273565">
                <% if (errors.isbn) { %>
                    <p class="field-error" id="isbn-error">
                        <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                        </svg>                        
                        <%= errors.isbn %>
                    </p>
                <% } %>
            </div>
            

            <fieldset aria-describedby="<%= errors.rating ? 'rating-error' : '' %>" role="radiogroup" aria-invalid="<%= errors.rating ? 'true' : 'false' %>">
                <legend>Your Rating</legend>
                <div class="star-input">
                    <% for (let i = 5; i >= 1; i--) { %>
                        <input type="radio" name="rating" id="rating-<%= i %>" value="<%= i %>" <%= book.rating === i ? "checked" : "" %>>
                        <label for="rating-<%= i %>">
                            <span class="visually-hidden"><%= i %> star<%= i > 1 ? "s" : "" %></span>
                            <%- include('partials/star', { filled: false }) %> 
                        </label>
                    <% } %>
                </div>
                <% if (errors.rating) { %>
                    <p class="field-error" id="rating-error">
                        <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                        </svg>  
                        <%= errors.rating %>
                    </p>
                <% } %>
                
            </fieldset>

            <div class="form-field">
                <label for="notes">Notes</label>
                <textarea name="notes" id="notes" rows="10" maxlength="1000" required aria-describedby="<%= errors.notes ? 'notes-error' : '' %> notes-count" aria-invalid="<%= errors.notes ? 'true' : 'false' %>"><%= book.notes %></textarea>
                <div class="notes-info">
                    <% if (errors.notes) { %>
                        <p class="field-error" id="notes-error">
                            <svg width="15" height="13" viewBox="0 0 15 13" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M0 12.6667H14.6667L7.33333 0L0 12.6667ZM8 10.6667H6.66667V9.33333H8V10.6667ZM8 8H6.66667V5.33333H8V8Z" fill="#E7000B"/>
                            </svg>  
                            <%= errors.notes %>
                        </p>
                    <% } %>
                    <span id="notes-count"><%= (book.notes || "").length %> / 1000</span>
                </div>
            </div>
            
            <button class="btn btn-sm btn-primary" type="submit">
                <span>
                    <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4.08333 0V8.16667M0 4.08333H8.16667" stroke="#F6F3EE" stroke-width="2"/>
                    </svg>    
                </span>
                Add book
            </button>
            <button class="btn btn-sm btn-secondary" type="button" id="open-cancel-dialog" data-cancel-href="/">
                Cancel
            </button>
        </form>
    </main>
</body>
</html>